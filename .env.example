# --- OANDA (PRACTICE account only — never put a live account here) ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Safety ---
# Set to "true" to halt all trading immediately, independent of the
# dashboard kill switch.
TRADING_KILL_SWITCH=false

# --- Persistence ---
DATABASE_URL=sqlite:///./trading_city.db

# --- Scheduler cadence ---
RESEARCH_INTERVAL_HOURS=6
TRADE_LOOP_TIMEFRAME=M15
